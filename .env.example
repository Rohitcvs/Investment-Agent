# Copy this file to .env and fill in your key. Never commit .env.
OPENAI_API_KEY=your-key-here

# Models (optimization: a cheaper model for the critic)
MAIN_MODEL=gpt-4o
CRITIC_MODEL=gpt-4o-mini

# Guardrails
REQUIRE_APPROVAL=true      # a person approves reports before they're saved
MAX_REVISIONS=3
AGENT_STEP_LIMIT=12        # max steps for each sub-agent's tool loop

# Resilience
CACHE_TTL_SECONDS=3600
RETRY_ATTEMPTS=3

# Optional: full tracing in LangSmith (observability)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-key
# LANGSMITH_PROJECT=investment-agent
